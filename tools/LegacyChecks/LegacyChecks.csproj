<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CitizenFxClientVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\..\src\Directory.Packages.props')), '"CitizenFX.Core.Client" Version="([^"]+)"').Groups[1].Value)</CitizenFxClientVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageDownload Include="CitizenFX.Core.Client" Version="[$(CitizenFxClientVersion)]" />
  </ItemGroup>
</Project>
