<Project>

  <!--
    Shared MSBuild settings for every vMenu Enhanced project (Client, Server, Shared).
    These are the .NET 10 class libraries that make up vMenu for FiveM Enhanced.

    FiveM Enhanced runtime / package wiring is intentionally NOT here yet: this is
    baseline project structure only. Add CitizenFX references once the Enhanced
    runtime packages are known.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Configurations>Release;Debug</Configurations>
    <DebugType>embedded</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <Authors>Tom Grobbe</Authors>
    <Copyright>Copyright (C) 2017-2026 Tom Grobbe</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>

    <!--
      Class libraries normally leave NuGet assemblies in the package cache and
      only list them in the .deps.json. FiveM has no host to resolve them, so
      every referenced assembly (MenuAPI, CitizenFX.*, MessagePack, ...) has to
      sit next to the resource. This copies the whole resolved graph to OutputPath.
    -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

    <!-- The .deps.json files are not used, so don't generate them during build. -->
    <GenerateDependencyFile>false</GenerateDependencyFile>

    <!--
      Every project emits into one shared folder (repo-root/build/vMenu.Enhanced/)
      so CI can zip the whole resource in a single step, mirroring the legacy
      build/vMenu/ convention.
    -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(MSBuildThisFileDirectory)..\build\vMenu.Enhanced\</OutputPath>
  </PropertyGroup>

</Project>
