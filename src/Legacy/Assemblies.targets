<Project>

  <!--
    Every assembly a side builds, copied into that side's folder in the resource.

    Projects build into build/intermediate/<side>/ and this assembles
    build/<flavor>/vMenu.Enhanced/<side>/ from that, so the resource folder only ever holds what actually
    ships.
  -->
  <PropertyGroup>
    <UnshippedAssemblies>CitizenFX.Core;CitizenFX.Core.Client;CitizenFX.Core.Server</UnshippedAssemblies>

    <ResourceSideDir>$(ResourceRoot)$(ResourceSide)\</ResourceSideDir>
  </PropertyGroup>

  <!--
    A file left over from an earlier build is still downloaded by every client and still resolvable
    by the host, so anything in the folder that this build did not put there is removed. Scoped to
    the one side's folder, which is regenerated output rather than anything a person edits.
  -->
  <Target Name="CopyResourceAssemblies"
          AfterTargets="Build"
          Condition="'$(IsResourceSideProject)' == 'true'">

    <ItemGroup>
      <SideCandidate Include="$(OutputPath)*.dll" />

      <SideAssembly Include="@(SideCandidate)"
                    Condition="!$([System.String]::Copy(';$(UnshippedAssemblies);').Contains(';%(Filename);'))" />

      <SideShipped Include="$(ResourceSideDir)*.dll;$(ResourceSideDir)*.xml" />

      <SideStale Include="@(SideShipped)"
                 Exclude="@(SideAssembly->'$(ResourceSideDir)%(Filename)%(Extension)')" />
    </ItemGroup>

    <MakeDir Directories="$(ResourceSideDir)" />

    <Message Importance="high" Text="Copying @(SideAssembly->Count()) $(ResourceSide) assemblies into the resource." />

    <Copy SourceFiles="@(SideAssembly)" DestinationFolder="$(ResourceSideDir)" SkipUnchangedFiles="true" />

    <Message Importance="high" Text="Removing stale $(ResourceSide) file @(SideStale->'%(Filename)%(Extension)', ', ')."
             Condition="'@(SideStale)' != ''" />

    <Delete Files="@(SideStale)" />
  </Target>

</Project>
