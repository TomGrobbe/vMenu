<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The server half of the vMenu Enhanced plugin API. A plugin's server script uses this
    to declare its permissions and convar settings with vMenu, and to check permissions.
  -->
  <PropertyGroup>
    <PackageDescription>Server side plugin API for vMenu Enhanced. Declares plugin permissions and settings with vMenu over events and offers permission checks.</PackageDescription>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CitizenFX.FiveM.Server" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\vMenu.Enhanced.PluginContracts\vMenu.Enhanced.PluginContracts.csproj" />
  </ItemGroup>

</Project>
