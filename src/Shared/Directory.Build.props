<Project>
  <!--
    MSBuild stops at the FIRST Directory.Build.props it finds walking up from a
    project, so this file shadows src/Directory.Build.props for everything under
    src/Shared/. Import the parent explicitly to keep the shared settings.
  -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('$(MSBuildThisFile)', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <TargetFrameworks>net10.0;net462</TargetFrameworks>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(RepoRoot)build\intermediate\shared\$(MSBuildProjectName)\</OutputPath>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\LegacyClient.props" Condition="'$(TargetFramework)' == 'net462'" />

</Project>
