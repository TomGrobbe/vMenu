<Project>
  <!--
    MSBuild stops at the FIRST Directory.Build.props it finds walking up from a
    project, so this file shadows src/Directory.Build.props for everything under
    src/Shared/. Import the parent explicitly to keep the shared settings.
  -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('$(MSBuildThisFile)', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!--
      Shared assemblies build outside the resource folder. A ProjectReference from either side
      already copies the output next to that side's assemblies, so a third copy in the resource
      would be dead weight. CI packages build/vMenu.Enhanced/*, so nothing here ships.
    -->
    <OutputPath>$(MSBuildThisFileDirectory)..\..\build\intermediate\$(MSBuildProjectName)\</OutputPath>
  </PropertyGroup>

</Project>
