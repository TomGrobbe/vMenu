<Project>
  <!--
    MSBuild stops at the FIRST Directory.Build.props it finds walking up from a
    project, so this file shadows src/Directory.Build.props for everything under
    src/Client/. Import the parent explicitly to keep the shared settings.
  -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('$(MSBuildThisFile)', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!--
      Client assemblies build outside the resource, and src/Bundle.targets merges them into the one
      that ships. Nothing here lands in build/vMenu.Enhanced/client/ except through that.

      The client and server sides stay in separate folders all the way through, because
      CitizenFX.FiveM.Client and CitizenFX.FiveM.Server each carry their own copy of
      CitizenFX.Base.dll and CitizenFX.FiveM.Shared.dll; sharing one folder means one side wins and
      the other loads the wrong assemblies.

      CopyLocalLockFileAssemblies (inherited from src/Directory.Build.props)
      copies the resolved NuGet graph next to the output, so MenuAPI and the
      CitizenFX client assemblies land here too.
    -->
    <OutputPath>$(MSBuildThisFileDirectory)..\..\build\intermediate\client\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'NativeHooks'">
    <NativeHooks>true</NativeHooks>
    <DefineConstants>$(DefineConstants);NATIVE_HOOKS</DefineConstants>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup Condition="'$(NativeHooks)' == 'true' And '$(MSBuildProjectName)' != 'vMenu.Enhanced.NativeHooks'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\tools\vMenu.Enhanced.NativeHooks.Generator\vMenu.Enhanced.NativeHooks.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)vMenu.Enhanced.NativeHooks\vMenu.Enhanced.NativeHooks.csproj" />
  </ItemGroup>

</Project>
